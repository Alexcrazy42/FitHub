# ============================================
# БЛОК 1: Node.js и зависимости
# ============================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
package-lock.json
yarn.lock
pnpm-lock.yaml

# ============================================
# БЛОК 2: Сборка и компиляция (TypeScript)
# ============================================
dist/
build/
*.tsbuildinfo
*.d.ts.map
*.js.map
*.js
!playwright.config.ts
!*.spec.ts
!*.test.ts

# ============================================
# БЛОК 3: Секреты и окружение (КРИТИЧНО!)
# ============================================
.env
.env.*
!.env.example
!.env.test.example

# Файлы с реальными credentials
*.local
*.secret
*.key
*.pem
*.crt

# ============================================
# БЛОК 4: Артефакты Playwright (генерятся автоматически)
# ============================================
# Основные артефакты
test-results/
playwright-report/
playwright/.cache/
reports/
coverage/
html-report/
junit.xml
results.json

# Трейсы, скриншоты, видео (могут весить гигабайты!)
traces/
screenshots/
videos/
*.trace.zip
*.png
*.webm
*.mp4

# Логи браузера
*.log
browser-logs/

# ============================================
# БЛОК 5: IDE и редакторы (универсальный)
# ============================================
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
*.iml
.project
.classpath
.settings/
.vscode-test/

# ============================================
# БЛОК 6: Временные файлы и кеш
# ============================================
*.tmp
*.temp
.cache/
.temp/
tmp/
temp/

# ============================================
# БЛОК 7: CI/CD артефакты (если билдятся локально)
# ============================================
*.zip
*.tar.gz
*.tgz
allure-results/
allure-report/

# ============================================
# БЛОК 8: Состояния браузера (опционально)
# ============================================
# Если ты сохраняешь cookies/localStorage для быстрого старта
# Их не стоит коммитить, т.к. они привязаны к конкретному окружению
fixtures/states/*.json
!fixtures/states/README.md

# ============================================
# БЛОК 9: Системные файлы
# ============================================
Thumbs.db
desktop.ini
*.bak
*.orig

# ============================================
# БЛОК 10: Docker (если используешь)
# ============================================
docker-compose.override.yml
.docker/
*.container

# ============================================
# БЛОК 11: Сгенерированные моками данные
# ============================================
mocks/generated/
fixtures/generated/
*.generated.json